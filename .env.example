# Copy to .env, never commit the real one.

# --- data source ---
SYMBOL=AAPL
INTERVAL=1m                 # 1m | 5m | 15m | 1h | 4h | 1d
INGEST_MODE=demo            # demo (offline synthetic) | live (a real source)
DEMO_INTERVAL_S=3
DEFAULT_SOURCE=alpaca       # alpaca | binance
QUOTE_ASSETS=USDT,USDC      # Binance pairs are filtered to these

# Alpaca is the default source: US stocks plus crypto, and being US-hosted
# it works from AWS and from regions where Binance answers HTTP 451.
# Without keys the registry falls back to Binance alone and logs it.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Two DIFFERENT hosts. Neither may end in /v2 - the code appends the
# version path, and a doubled /v2/v2 returns 404. Startup refuses one.
ALPACA_BASE_URL=https://paper-api.alpaca.markets    # trading: assets, clock
ALPACA_DATA_URL=https://data.alpaca.markets         # market data: bars
ALPACA_FEED=iex             # free tier

# --- LLM (any OpenAI-compatible provider) ---
LLM_PROVIDER=mock           # mock | openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=1

# --- analyzer ---
ANALYZE_EVERY=1             # analyze every Nth closed bar

# --- bring your own key ---
# Visitors may send their own LLM key in an X-LLM-Key header. It is used for
# that one request and never written down. These are the guard rails.
RATE_LIMIT_PER_HOUR=60          # per IP, whoever's key is used. 0 disables
TRUST_PROXY_HEADERS=false       # true only behind a proxy that rewrites XFF
ALLOW_INSECURE_KEY_HEADER=false # never true in production - HTTPS only

# --- api ---
# Origins allowed to call the api from a browser. The terminal's dev server
# is :5174 and its preview server :4173; add your deployed frontend here.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173

# --- infra ---
NATS_URL=nats://localhost:4222
DB_PATH=candle_agent.db
